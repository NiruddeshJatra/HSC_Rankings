# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=boardexamrankings.vercel.app,.vercel.app,localhost,127.0.0.1
DJANGO_ENABLE_ADMIN=0

# Database (Supabase Postgres)
# MUST use the Supabase transaction pooler (port 6543), not the direct connection (5432) -
# serverless functions cannot hold persistent connections.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
